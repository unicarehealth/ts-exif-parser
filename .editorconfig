# The EditorConfig configuration (https://editorconfig.org/).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = tab
# This matches the tab width that our ESLint configuration uses to measure line
# lengths.
tab_width = 8

# YAML doesn't allow tabs for indentation.
[*.{yaml,yml}]
indent_style = space
indent_size = 2
